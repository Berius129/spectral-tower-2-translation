  {"start": 527, "end": 626, "area": "bottom", "text": "Who will judge that sin?"},
  {"start": 661, "end": 733, "area": "bottom", "text": "A tower that grants forbidden human desires."},
  {"start": 736, "end": 808, "area": "bottom", "text": "Only those who reach its summit"},
